# Configuración del modelo de embeddings en Microsoft Foundry.
# Copia este archivo como `.env` y rellena los valores reales.

# URL del endpoint del recurso de Foundry.
# Formato típico: https://<nombre-recurso>.services.ai.azure.com/models
AZURE_FOUNDRY_ENDPOINT=https://tu-recurso.services.ai.azure.com/models

# Clave de API del recurso (Keys and Endpoint en el portal de Azure).
AZURE_FOUNDRY_KEY=tu-clave-aqui

# Nombre del modelo desplegado (deployment name).
# Ejemplos: text-embedding-3-small, text-embedding-3-large, Cohere-embed-v3-english
AZURE_FOUNDRY_DEPLOYMENT=text-embedding-3-small
